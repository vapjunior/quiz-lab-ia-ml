    "eslint": "^10.0.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.0.0",
    "jsdom": "^29.0.2",
    "prettier": "^3.8.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.5",
